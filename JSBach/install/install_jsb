#!/bin/bash

source install_variables.conf

######################################################################
###  Funcions
######################################################################

fnc_copia_fitxers() {

	echo "📁 Copiant fitxers a $DESTI_FINAL..."

	
}

fnc_instala_aplicacions() {
	### Comprovar connexió a internet
	echo "🔍 Comprovant connexió a internet..."
	servidors_dns=$(resolvectl status | grep 'DNS Servers' | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}')

	connexio=0

	for dns in $servidors_dns; do
		echo "Provant $dns ..."
		if ping -c1 -W1 "$dns" >/dev/null 2>&1; then
			connexio=1
			echo "✅ Connexió a internet detectada"
			break
		fi
	done

	if [ "$connexio" -eq 0 ]; then
		echo "❌ Error: No s'ha detectat connexió a internet. L'instal·lació d'aplicacions s'ha aturat."
		exit 1
	fi

	### instal·lar aplicacions

	echo "⚙️ instal·lar aplicacions"

	apt update

}

fnc_instala_servei() {
	### activar JSBach
	echo "✅ Activant JSBach..."

	
}

######################################################################
###  Main
######################################################################

if [[ "$EUID" -ne 0 ]]; then
	echo "Aquest script s'ha d'executar com a root" >&2
	exit 1
fi

# si no hi ha arguments ho fat tot
if [ $# -lt 1 ]; then
	fnc_copia_fitxers
	fnc_instala_aplicacions
	fnc_instala_servei
	exit 1
fi

OPCIO_1=$1
shift

# Fem switch per executar la funció que toca
case "$OPCIO_1" in
-f)
	fnc_copia_fitxers
	;;
-a)
	fnc_instala_aplicacions
	;;
-s)
	fnc_instala_servei
	;;
*)
	echo "-f sols instal·la els fitxer"
	echo "-a sols instal·la les aplicacion amb apt"
	echo "-s sols instal·la i arranca el servei jsbach_srv"
	;;
esac
