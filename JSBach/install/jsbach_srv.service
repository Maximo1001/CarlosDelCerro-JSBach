[Unit]
Description=JSBACH CLI TCP Service

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:1234,bind=*,reuseaddr,fork EXEC:/usr/local/JSBach/system/jsbach_cli
Restart=always

[Install]
WantedBy=multi-user.target

