#!/bin/bash

######################################################################
###  Estat
######################################################################
fnc_wan_estat() {
	echo fnc_wan_estat
		
	if systemctl is-active --quiet NetworkManager; then
		echo "$DESACTIVAT"
		echo "NetworkManager funcionant"
	elif [ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6)" -eq 0 ]; then
		echo "$DESACTIVAT"
		echo "Ipv6 funcionant"
	elif [[ "$WAN_MODE" == "manual" ]] && [[ $(resolvectl dns| grep $WAN_INT| awk '{print $4}') != "$WAN_DNS" ]]; then
		echo "$DESACTIVAT"
		echo "No es el servidor DNS de la configuracio"
	elif  ! ping -c 1 -W 2 "$(resolvectl dns| grep $WAN_INT| awk '{print $4}')" &>/dev/null ; then
		echo "$DESACTIVAT"
		echo "No respon  el servidor DNS"	
	else
		echo "$ACTIVAT"
	fi

}
